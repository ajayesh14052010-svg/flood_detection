# ---------------------------------------------------------------------------
# FloodGuard environment placeholders ONLY. Copy to `.env` and fill real values.
# NEVER commit a populated .env — it must stay out of Git (see .gitignore).
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Production uses PostgreSQL (Neon). The Prisma datasource provider is
# "postgresql" and the connection string is read from DATABASE_URL.
# NEVER commit a real connection string — keep it in .env (gitignored) and in
# your host's environment (e.g. Vercel Project Settings → Environment Variables).
#
# Use the Neon POOLED connection string for serverless (Vercel):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-PPOOLER.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-PPOOLER.REGION.aws.neon.tech/neondb?sslmode=require"

# OPTIONAL (CLI only): a DIRECT, non-pooler Neon URL for running migrations
# (`prisma migrate deploy`). The schema does NOT reference it, because Prisma's
# validate/generate fail (P1012) if a schema-referenced env var is unset, which
# would break the Vercel build. When you migrate, either set DATABASE_URL to the
# direct URL for that one command, or export DIRECT_URL and pass it explicitly.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Admin authentication -------------------------------------------------
# Secret used to sign admin session cookies. Use a long random string in prod.
AUTH_SECRET="change-me-to-a-long-random-secret"
# Seed admin bootstrap credentials (used only by `npm run db:seed`).
# In production, provision the admin via the seeded flow then change the
# password; do NOT reuse these placeholder values.
ADMIN_EMAIL="admin@example.local"
ADMIN_PASSWORD="change-me-admin-password"

# --- Device ingestion -----------------------------------------------------
# Master secret used to derive/verify per-device tokens during registration.
# Real device tokens are stored hashed per device in the database.
DEVICE_TOKEN_SECRET="change-me-to-a-long-random-secret"

# --- Demo / simulation ----------------------------------------------------
# When "true", the seed creates clearly-labelled SIMULATED readings so the UI
# can be exercised before hardware is connected. Set "false" for production.
DEMO_MODE="true"

# --- Ingestion limits -----------------------------------------------------
# Readings older than this (seconds) with no newer packet are flagged STALE;
# devices with no packet for STALE_SECONDS*2 are treated as SENSOR OFFLINE.
STALE_SECONDS="900"
# Simple per-IP rate limit (requests / window) for public + device endpoints.
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"
