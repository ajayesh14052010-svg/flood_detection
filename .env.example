# ---------------------------------------------------------------------------
# FloodGuard environment placeholders ONLY. Copy to `.env` and fill real values.
# NEVER commit a populated .env — it must stay out of Git (see .gitignore).
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) -------------------------------------------
# Production uses PostgreSQL on Neon. The Prisma datasource provider is
# "postgresql". BOTH variables below are REQUIRED — the schema references them,
# and Prisma's validate/generate fail with P1012 if either is unset, which would
# break the Vercel build. NEVER commit real strings; keep them in .env
# (gitignored) and in Vercel Project Settings → Environment Variables.
#
# DATABASE_URL = Neon POOLED connection (host contains "-pooler"). Used by the
# running app and by `prisma generate`. Serverless-safe: the pooler bounds
# concurrent connections so Vercel functions do not exhaust the Neon limit.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-PPOOLER.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DIRECT_URL = Neon DIRECT connection (same string WITHOUT "-pooler"). Used only
# by the Prisma CLI for migrations (`prisma migrate deploy`), which need a real
# session the pooler does not provide. The app never uses this at runtime.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Admin authentication -------------------------------------------------
# Secret used to sign admin session cookies. Use a long random string in prod.
AUTH_SECRET="change-me-to-a-long-random-secret"
# Seed admin bootstrap credentials (used only by `npm run db:seed`).
# In production, provision the admin via the seeded flow then change the
# password; do NOT reuse these placeholder values.
ADMIN_EMAIL="admin@example.local"
ADMIN_PASSWORD="change-me-admin-password"

# --- Device ingestion -----------------------------------------------------
# Master secret used to derive/verify per-device tokens during registration.
# Real device tokens are stored hashed per device in the database.
DEVICE_TOKEN_SECRET="change-me-to-a-long-random-secret"

# --- Demo / simulation ----------------------------------------------------
# When "true", the seed creates clearly-labelled SIMULATED readings so the UI
# can be exercised before hardware is connected. Set "false" for production.
DEMO_MODE="true"

# --- Ingestion limits -----------------------------------------------------
# Readings older than this (seconds) with no newer packet are flagged STALE;
# devices with no packet for STALE_SECONDS*2 are treated as SENSOR OFFLINE.
STALE_SECONDS="900"
# Simple per-IP rate limit (requests / window) for public + device endpoints.
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"
